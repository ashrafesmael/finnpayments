# FinnPayments — nginx vhost for payments.finnverify.com
# Proxies to the Vite dev server on localhost:3001 with SSL.
#
# Install:
#   sudo cp deploy/payments.finnverify.com.nginx /etc/nginx/sites-available/payments
#   sudo ln -sf /etc/nginx/sites-available/payments /etc/nginx/sites-enabled/payments
#   sudo certbot --nginx -d payments.finnverify.com
#   sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    listen [::]:80;
    server_name payments.finnverify.com;

    # Certbot will add the 301 redirect and SSL block automatically.
    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_buffering off;
    }

    # Uploads up to 25 MB (matches backend MAX_UPLOAD_BYTES).
    client_max_body_size 25M;
}
