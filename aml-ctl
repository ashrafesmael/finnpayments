#!/bin/bash
case "$1" in
  start)   sudo systemctl start finnverify-backend finnverify-frontend ;;
  stop)    sudo systemctl stop finnverify-backend finnverify-frontend ;;
  restart) sudo systemctl restart finnverify-backend finnverify-frontend ;;
  status)  sudo systemctl status finnverify-backend finnverify-frontend ;;
  *)       echo "Usage: $0 {start|stop|restart|status}" ;;
esac
